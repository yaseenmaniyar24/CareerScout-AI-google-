# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AQ.Ab8RN6L3vyxVo0NTW299hyj80XqX8Nu1o5rb7DwFM_hoNGWFvQ"

# SERPAPI_API_KEY: Required for live Google Jobs search via SerpApi.
# Obtain a key at https://serpapi.com/ (free tier includes 100 searches/month)
SERPAPI_API_KEY="8664d08660d5a15d121deb71dbdf9d2e9a5a4afa8c86a9efdcad18ed37d1163d"

# DEMO_MODE: Set to "true" to enable realistic Indian college & graduate mock search
# data when API keys are not provided or SerpApi limits are exhausted.
DEMO_MODE="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

